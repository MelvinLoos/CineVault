# =============================================================================
# docker-compose.yml — Prosumer Edge Media Hub
# Deployed to: /opt/mediastack/docker-compose.yml on The Host
#
# Spec references:
#   CONSTITUTION.MD     — Non-negotiable tech stack & architectural maxims
#   ARCHITECTURE.md     — Network topography, file system, resource constraints
#   PRODUCT_SPECIFICATION.md — DDD Ubiquitous Language & Bounded Contexts
#   AGENTS.md           — Zero Root Execution, State vs. Compute, Idempotency
#
# Idempotency: Docker Compose is declarative. Re-running `docker compose up -d`
# is always safe — it only creates or recreates containers whose definition
# has changed. No manual cleanup is required between runs. (AGENTS.md §3)
#
# Volume path convention: all paths are relative to this file's location
# (/opt/mediastack/). They resolve to absolute paths on The Host automatically.
# No volumes are mapped outside /opt/mediastack/ (State vs. Compute — AGENTS.md §3).
# =============================================================================

# ---------------------------------------------------------------------------
# Zero-Trust Network Micro-segmentation (ARCHITECTURE.md §2)
# Three isolated bridge networks. No service may communicate across a network
# boundary unless it is explicitly attached to both networks.
# ---------------------------------------------------------------------------
networks:
  ingress_net:
    driver: bridge
    # Boundary: cloudflared → seerr → jellyfin
    # Connects The Ingress to user-facing services only.
    # No direct path to acquisition or processing services.

  internal_api:
    driver: bridge
    # Boundary: seerr ↔ radarr ↔ sonarr
    # Scoped to Acquisition bounded-context API calls initiated by seerr.
    # Not reachable from The Ingress or The Download Client.

  acquisition_net:
    driver: bridge
    # Boundary: radarr ↔ sonarr ↔ prowlarr ↔ sabnzbd
    # Scoped to Acquisition and Processing bounded contexts.
    # The Indexer and The Download Client are isolated here.

  socket_proxy_net:
    driver: bridge
    # Boundary: homepage / watchtower → docker-proxy
    # Scoped to Docker socket abstraction for security.

# ---------------------------------------------------------------------------
# Service Definitions
# Global rules applied to ALL services (unless an explicit exception is noted):
#   - PUID / PGID: ${PUID} / ${PGID} sourced from .env
#     Canonical values: PUID=5000, PGID=5000 (mediasvc) — provision_host.yml is authoritative
#     Zero Root Execution — AGENTS.md §3, ARCHITECTURE.md §3
#   - TZ: ${TZ} sourced from .env
#   - restart: unless-stopped
#   - Health checks: every long-running service defines a healthcheck so its
#     state is visible via the `docker ps` HEALTH column and the Homepage
#     docker widget. Documented exceptions: cloudflared ships a distroless
#     image (no shell, no HTTP client), recyclarr is a one-shot maintenance
#     run, and homepage/wizarr/maintainerr/gluetun/watchtower rely on the
#     healthcheck baked into their images.
#   - All volume mounts within /opt/mediastack/ (State vs. Compute — AGENTS.md §3)
# ---------------------------------------------------------------------------
services:

  # ---------------------------------------------------------------------------
  # Delivery Bounded Context (PRODUCT_SPECIFICATION.md §2)
  # Delivery context — Intel QuickSync hardware transcoding via /dev/dri/renderD128
  # ---------------------------------------------------------------------------
  jellyfin:
    image: lscr.io/linuxserver/jellyfin:latest # Changed to LSIO
    container_name: jellyfin
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
      - UMASK=002
    volumes:
      - ./appdata/jellyfin:/config
      - ./data:/data:ro
{% if host_has_quicksync %}
    devices:
      - /dev/dri/renderD128:/dev/dri/renderD128
{% endif %}
    networks:
      - ingress_net
    restart: unless-stopped
    ports:
      - "8096:8096"
    # Health check: Jellyfin exposes an unauthenticated /health endpoint
    # (HTTP 200 "Healthy") on its default HTTP port.
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost:8096/health"]
      interval: 30s
      timeout: 5s
      start_period: 60s
      retries: 3

  # ---------------------------------------------------------------------------
  # Acquisition Bounded Context — The Library: movies (PRODUCT_SPECIFICATION.md §2)
  # Acquisition context — manages The Library: movies. Full /data mount required for atomic hardlinks.
  # ---------------------------------------------------------------------------
  radarr:
    image: lscr.io/linuxserver/radarr:latest
    container_name: radarr
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
      - UMASK=002
    volumes:
      - ./appdata/radarr:/config
      - ./data:/data  # Full /data subtree required for atomic hardlinks between usenet/ and media/
    networks:
      - internal_api
      - acquisition_net
    restart: unless-stopped
    ports:
      - "7878:7878"
    # Health check: Radarr's unauthenticated /ping endpoint replies 200 "pong".
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost:7878/ping"]
      interval: 30s
      timeout: 5s
      start_period: 40s
      retries: 3

  # ---------------------------------------------------------------------------
  # Acquisition Bounded Context — The Library: tv (PRODUCT_SPECIFICATION.md §2)
  # Acquisition context — manages The Library: tv. Full /data mount required for atomic hardlinks.
  # ---------------------------------------------------------------------------
  sonarr:
    image: lscr.io/linuxserver/sonarr:latest
    container_name: sonarr
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
      - UMASK=002
    volumes:
      - ./appdata/sonarr:/config
      - ./data:/data  # Full /data subtree required for atomic hardlinks between usenet/ and media/
    networks:
      - internal_api
      - acquisition_net
    restart: unless-stopped
    ports:
      - "8989:8989"
    # Health check: Sonarr's unauthenticated /ping endpoint replies 200 "pong".
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost:8989/ping"]
      interval: 30s
      timeout: 5s
      start_period: 40s
      retries: 3

  # ---------------------------------------------------------------------------
  # Acquisition Bounded Context — The Indexer (PRODUCT_SPECIFICATION.md §1 & §2)
  # Acquisition context — The Indexer. Bridges Usenet indexers to Radarr and Sonarr.
  # ---------------------------------------------------------------------------
  prowlarr:
    image: lscr.io/linuxserver/prowlarr:latest
    container_name: prowlarr
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
      - UMASK=002
    volumes:
      - ./appdata/prowlarr:/config
    networks:
      - acquisition_net
    restart: unless-stopped
    ports:
      - "9696:9696"
    # Health check: Prowlarr's unauthenticated /ping endpoint replies 200 "pong".
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost:9696/ping"]
      interval: 30s
      timeout: 5s
      start_period: 40s
      retries: 3


  # ---------------------------------------------------------------------------
  # Acquisition Bounded Context — Spotweb (Dutch Usenet Indexer)
  # ---------------------------------------------------------------------------
  spotweb-db:
    image: lscr.io/linuxserver/mariadb:latest
    container_name: spotweb-db
    restart: unless-stopped
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
      - MYSQL_ROOT_PASSWORD=${SPOTWEB_DB_ROOT_PASSWORD}
      - MYSQL_DATABASE=${SPOTWEB_DB_NAME}
      - MYSQL_USER=${SPOTWEB_DB_USER}
      - MYSQL_PASSWORD=${SPOTWEB_DB_PASSWORD}
    volumes:
      - ./appdata/spotweb-db:/config
    networks:
      - acquisition_net
    # Health check: ping the MariaDB server with the root credentials. CMD-SHELL
    # is required so $$MYSQL_ROOT_PASSWORD ($$ escapes Compose interpolation)
    # is expanded by the container shell at runtime.
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -u root -p\"$$MYSQL_ROOT_PASSWORD\" --silent"]
      interval: 30s
      timeout: 5s
      start_period: 60s
      retries: 3

  spotweb:
    image: jgeusebroek/spotweb:latest
    container_name: spotweb
    restart: unless-stopped
    depends_on:
      # Gate on health, not merely on container start: MariaDB's healthcheck
      # carries a 60s start_period while InnoDB initialises, and spotweb used
      # to race it and fail with "Can't connect to MySQL server on
      # 'spotweb-db'" (see docs/configuration/spotweb.md troubleshooting).
      spotweb-db:
        condition: service_healthy
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
      - SPOTWEB_DB_TYPE=pdo_mysql
      - SPOTWEB_DB_HOST=spotweb-db
      - SPOTWEB_DB_PORT=3306
      - SPOTWEB_DB_NAME=${SPOTWEB_DB_NAME}
      - SPOTWEB_DB_USER=${SPOTWEB_DB_USER}
      - SPOTWEB_DB_PASS=${SPOTWEB_DB_PASSWORD}
      - SPOTWEB_CRON_RETRIEVE=*/15 * * * *
    ports:
      - "8085:80"
    volumes:
      - ./appdata/spotweb:/config
    networks:
      - acquisition_net
    # Health check: Spotweb's nginx frontend answers on container port 80.
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://localhost/"]
      interval: 30s
      timeout: 5s
      start_period: 60s
      retries: 3


  # ---------------------------------------------------------------------------
  # Acquisition Bounded Context — Subtitle Sync (PRODUCT_SPECIFICATION.md §2)
  # ---------------------------------------------------------------------------
  bazarr:
    image: lscr.io/linuxserver/bazarr:latest
    container_name: bazarr
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
      - UMASK=002
    volumes:
      - ./appdata/bazarr:/config
      - ./data:/data
    networks:
      - internal_api
      - ingress_net
    restart: unless-stopped
    ports:
      - "6767:6767"
    # Health check: Bazarr's web UI answers on its default HTTP port.
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost:6767/"]
      interval: 30s
      timeout: 5s
      start_period: 40s
      retries: 3

  # ---------------------------------------------------------------------------
  # Processing Bounded Context — The Download Client (PRODUCT_SPECIFICATION.md §1 & §2)
  # Processing context — The Download Client. Resource-limited to prevent host starvation during unpack.
  # ---------------------------------------------------------------------------
  gluetun:
    image: qmcgaw/gluetun:latest
    container_name: gluetun
    profiles:
      - vpn
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    volumes:
      - ./appdata/gluetun:/gluetun
    networks:
      - acquisition_net
      - ingress_net
    ports:
      - "8090:8090" # qBittorrent WebUI
    environment:
      - VPN_SERVICE_PROVIDER=${VPN_SERVICE_PROVIDER}
      - VPN_TYPE=${VPN_TYPE}
      - WIREGUARD_PRIVATE_KEY=${WIREGUARD_PRIVATE_KEY}
      - WIREGUARD_ADDRESSES=${WIREGUARD_ADDRESSES}
    restart: unless-stopped
    # No compose-level healthcheck: the qmcgaw/gluetun image ships its own
    # HEALTHCHECK that verifies the VPN tunnel is actually up (DNS + port).

  qbittorrent:
    image: lscr.io/linuxserver/qbittorrent:latest
    container_name: qbittorrent
    profiles:
      - vpn
    network_mode: "service:gluetun"
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
      - WEBUI_PORT=8090
      - UMASK=002
    volumes:
      - ./appdata/qbittorrent:/config
      - ./data:/data
    depends_on:
      - gluetun
    restart: unless-stopped
    # Health check: qBittorrent shares gluetun's network namespace, so
    # localhost:8090 reaches its WebUI from inside the container.
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost:8090/"]
      interval: 30s
      timeout: 5s
      start_period: 40s
      retries: 3

  sabnzbd:
    image: lscr.io/linuxserver/sabnzbd:latest
    container_name: sabnzbd
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
      - UMASK=002
    volumes:
      - ./appdata/sabnzbd:/config
      - ./data:/data
    networks:
      - acquisition_net
    # Non-negotiable resource limits — ARCHITECTURE.md §3
    # Prevents The Host from being starved during SABnzbd unpack operations.
    deploy:
      resources:
        limits:
          cpus: "2.0"
          memory: 2g
    restart: unless-stopped
    ports:
      - "8080:8080"
    # Health check: SABnzbd's web UI answers (HTTP 303 to the login page).
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost:8080/"]
      interval: 30s
      timeout: 5s
      start_period: 40s
      retries: 3

  # ---------------------------------------------------------------------------
  # Processing Bounded Context — Media Optimization (PRODUCT_SPECIFICATION.md §2)
  # Processing context — library media codec optimization.
  # ---------------------------------------------------------------------------
  tdarr:
    image: ghcr.io/haveagitgat/tdarr:latest
    container_name: tdarr
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
      - serverIP=0.0.0.0
      - serverPort=8266
      - webUIPort=8265
      - internalNode=true
      - nodeID=MyInternalNode
      - inContainer=true
      - nodeName=MyInternalNode
    volumes:
      - ./appdata/tdarr/server:/app/server
      - ./appdata/tdarr/configs:/app/configs
      - ./data:/data
      - ./data/transcode_cache:/temp
{% if host_has_quicksync %}
    devices:
      - /dev/dri/renderD128:/dev/dri/renderD128
{% endif %}
    networks:
      - acquisition_net
      - ingress_net
    restart: unless-stopped
    ports:
      - "8265:8265"   # Web UI
      - "8266:8266"   # Server control plane — external Tdarr nodes (on-demand laptop GPU offload). UFW-scoped to the auto-detected LAN subnet (media_subnet_cidr) by the provision playbook.
    # Health check: Tdarr's combined server/node WebUI answers on 8265.
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://localhost:8265/"]
      interval: 30s
      timeout: 5s
      start_period: 60s
      retries: 3


  # ---------------------------------------------------------------------------
  # Media Request + Identity & Access Bounded Contexts (PRODUCT_SPECIFICATION.md §2)
  # Media Request + Identity & Access contexts — the user-facing discovery and request UI.
  # ---------------------------------------------------------------------------
  seerr:
    image: ghcr.io/seerr-team/seerr:latest
    container_name: seerr
    user: ${PUID}:${PGID}
    environment:
      - TZ=${TZ}
    volumes:
      - ./appdata/seerr:/app/config
    networks:
      - ingress_net
      - internal_api
    restart: unless-stopped
    ports:
      - "5055:5055"
    # Health check: Seerr's public status endpoint (no API key required).
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://localhost:5055/api/v1/status"]
      interval: 30s
      timeout: 5s
      start_period: 40s
      retries: 3

  wizarr:
    image: ghcr.io/wizarrrr/wizarr:latest
    container_name: wizarr
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
    volumes:
      - ./appdata/wizarr:/data
    networks:
      - ingress_net
    restart: unless-stopped
    ports:
      - "5690:5690"
    # No compose-level healthcheck: the Wizarr image ships its own HEALTHCHECK
    # (visible as (healthy) in `docker ps`).

  homepage:
    image: ghcr.io/gethomepage/homepage:latest
    container_name: homepage
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
      - "HOMEPAGE_ALLOWED_HOSTS=*"
      - HOMEPAGE_VAR_RADARR_KEY=${RADARR_API_KEY}
      - HOMEPAGE_VAR_SONARR_KEY=${SONARR_API_KEY}
      - HOMEPAGE_VAR_SABNZBD_KEY=${SABNZBD_API_KEY}
      - HOMEPAGE_VAR_PROWLARR_KEY=${PROWLARR_API_KEY}
      - HOMEPAGE_VAR_BAZARR_KEY=${BAZARR_API_KEY}
      - HOMEPAGE_VAR_JELLYFIN_KEY=${JELLYFIN_API_KEY}
      - HOMEPAGE_VAR_SEERR_KEY=${SEERR_API_KEY}
      - HOMEPAGE_VAR_TDARR_KEY=${TDARR_API_KEY}
      - UMASK=002
    ports:
      - "80:3000"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      - ./appdata/homepage:/app/config
      - ./data:/data:ro  # Media payload mount for the storage resource widget
    networks:
      - ingress_net
      - socket_proxy_net
      - internal_api
      - acquisition_net
    restart: unless-stopped
    # No compose-level healthcheck: the Homepage image ships its own
    # HEALTHCHECK (visible as (healthy) in `docker ps`).

  # ---------------------------------------------------------------------------
  # Ingress Bounded Context — The Ingress (PRODUCT_SPECIFICATION.md §1)
  # Ingress context — The Ingress. Zero-trust Cloudflare Tunnel. No port-forwarding required (CONSTITUTION.MD Maxim 4).
  # PUID/PGID intentionally omitted: cloudflared manages its own non-root internal user.
  # ---------------------------------------------------------------------------
  cloudflared:
    image: cloudflare/cloudflared:latest
    container_name: cloudflared
    profiles:
      - ingress
    command: tunnel --no-autoupdate run
    # SECURITY: --token is intentionally omitted from the CLI command.
    # CLI arguments are visible in /proc/*/cmdline and `ps aux` to any user on The Host.
    # cloudflared reads TUNNEL_TOKEN from the environment variable natively (line below).
    # No volumes: cloudflared is stateless compute — all tunnel state lives in Cloudflare's control plane.
    networks:
      - ingress_net
    restart: unless-stopped
    environment:
      - TUNNEL_TOKEN=${CLOUDFLARED_TOKEN}
    # No healthcheck possible: the cloudflared image is distroless — it ships
    # no shell and no HTTP client, and the binary offers no self-status
    # subcommand without a tunnel name. Liveness is covered by the restart
    # policy; tunnel connectivity is monitored in the Cloudflare dashboard.

  # ---------------------------------------------------------------------------
  # Observability Bounded Context
  # Observability context — container log streaming (Dozzle) and endpoint
  # status monitoring (Uptime Kuma). LAN-only operational tools: their WebUI
  # ports are published on The Host but UFW-scoped to the auto-detected local
  # subnet (zero-trust micro-segmentation, ARCHITECTURE.md §2). Both share
  # ingress_net with homepage and cloudflared so the dashboard can link to
  # them and The Ingress can route dedicated hostnames to them later.
  # ---------------------------------------------------------------------------
  dozzle:
    image: amir20/dozzle:latest
    container_name: dozzle
    # Zero Root Execution (AGENTS.md §3): run as the non-root mediasvc user
    # with the host 'docker' group GID as a supplementary group —
    # /var/run/docker.sock is owned root:docker (same pattern as docker-proxy).
    user: ${PUID}:${PGID}
    group_add:
      - ${DOCKER_GROUP_GID}
    volumes:
      # Dozzle persists users & settings (auth config, pinned containers) in
      # /data — config state on the fast SSD per ARCHITECTURE.md §1. Without
      # this mount they are lost on every container recreation.
      - ./appdata/dozzle:/data
      # Read-only: stream container logs (e.g. Watchtower update runs) without
      # granting any write/control access to the Docker API.
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - ingress_net
    restart: unless-stopped
    ports:
      # Container port 8080 collides with SABnzbd's host mapping, so the
      # WebUI is published on 8888. UFW-scoped to the LAN subnet by
      # provision_host.yml (security role).
      - "8888:8080"
    # Health check: Dozzle ships a built-in healthcheck subcommand that pings
    # its own /healthcheck endpoint and reports local Docker client liveness.
    healthcheck:
      test: ["CMD", "/dozzle", "healthcheck"]
      interval: 30s
      timeout: 10s
      start_period: 30s
      retries: 3

  uptime-kuma:
    # Patch-pinned (`2.5.5` — upstream publishes no minor rollup tag) to
    # freeze the unsupported setup/API surface the deployment role automates
    # against. 1.x is unmaintained. Watchtower will NOT move a patch tag, so
    # bump to the next 2.5.x manually. Unlike 1.x (upstream issue #857), the
    # 2.x entrypoint performs no root-only chown maintenance, so the
    # container runs directly as the non-root mediasvc user.
    image: louislam/uptime-kuma:2.5.5
    container_name: uptime-kuma
    # Zero Root Execution (AGENTS.md §3): explicit non-root mediasvc runtime user.
    user: ${PUID}:${PGID}
    environment:
      - TZ=${TZ}
      # Honour X-Forwarded-* headers once served through The Ingress
      # (status.example.com) — harmless while LAN-only.
      - UPTIME_KUMA_TRUST_PROXY=1
    volumes:
      - ./appdata/uptime-kuma:/app/data  # Config state (fast SSD — ARCHITECTURE.md §1)
    networks:
      - ingress_net
      # Health probes for the *arr stack cross the micro-segmentation
      # boundaries, so the monitor shares homepage's justified exception of
      # attaching to the internal API and acquisition networks.
      - internal_api   # Radarr / Sonarr / Seerr health probes
      - acquisition_net  # SABnzbd / Prowlarr health probes
      # Enables the manual Docker-host monitor (Settings -> Docker Hosts ->
      # tcp://docker-proxy:2375) through the constrained socket proxy.
      - socket_proxy_net
    restart: unless-stopped
    ports:
      - "3001:3001"  # WebUI. UFW-scoped to the LAN subnet by provision_host.yml.
    # Health check: use the image's own purpose-built probe (extra/healthcheck
    # — the same binary upstream wires into the image HEALTHCHECK, incl. the
    # rootless variant) instead of a hand-rolled HTTP probe, which can misfire
    # when the SPA redirects unauthenticated requests. start_period is
    # generous for the ~600MB image and DB initialisation on the N100.
    healthcheck:
      test: ["CMD", "extra/healthcheck"]
      interval: 30s
      timeout: 10s
      start_period: 120s
      retries: 3

  # ---------------------------------------------------------------------------
  # Maintenance Bounded Context (PRODUCT_SPECIFICATION.md §2)
  # Security context — Docker Socket Proxy to avoid mounting /var/run/docker.sock in user-facing/app containers.
  # ---------------------------------------------------------------------------
  docker-proxy:
    # Patch-pinned to v0.4.2 (the pre-HAProxy-3.4.2 line). v0.5.0 bumped
    # HAProxy to 3.4.2 and upstream issue #180 reports it breaking endpoint
    # handling (regression introduced by PR #179). Bump manually once fixed.
    image: tecnativa/docker-socket-proxy:v0.4.2
    container_name: docker-proxy
    # Zero Root Execution (AGENTS.md §3): the bundled HAProxy must not run as root.
    # - user: run every process as the mediasvc service account.
    # - group_add: HAProxy still needs to reach /var/run/docker.sock (srw-rw----
    #   root:docker); the host 'docker' group GID is injected by the playbook.
    # - tmpfs /run: HAProxy requires a writable pidfile at /run/haproxy.pid.
    user: ${PUID}:${PGID}
    group_add:
      - ${DOCKER_GROUP_GID}
    tmpfs:
      - /run:rw,mode=1777
    # HARDENING: exclude the proxy from watchtower's update cycle. If
    # watchtower recreates the proxy mid-session it drops the very API
    # connection the remaining container updates flow through — on
    # 2026-10-03 a failed mid-flight update left four services down for
    # 16+ hours. The proxy is instead updated with the normal stack deploy.
    labels:
      - com.centurylinklabs.watchtower.enable=false
    environment:
      - CONTAINERS=1
      - IMAGES=1
      - POST=1
      - DELETE=1
      # Uptime Kuma's Docker-host connection test performs an /info handshake
      # alongside /containers/json (server/docker.js). INFO defaults to 0 in
      # the proxy image, so without this flag HAProxy's catch-all deny
      # returns 403 when Settings -> Docker Hosts -> Add is used.
      - INFO=1
      - VERSION=1
      # Watchtower lifecycle permissions. CONTAINERS alone grants kill/create
      # but NOT the start/stop/restart verbs or network attachment that a
      # full container update requires. Without these, watchtower creates
      # replacement containers it can never start — leaving services down
      # (the 2026-10-03 Jellyfin outage). Homepage's Docker widget needs the
      # same verbs for its restart/stop/start buttons.
      - ALLOW_START=1
      - ALLOW_STOP=1
      - ALLOW_RESTARTS=1
      - NETWORKS=1
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - socket_proxy_net
    restart: unless-stopped
    # Health check: the proxy answers Docker's /_ping on its listening port.
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:2375/_ping"]
      interval: 30s
      timeout: 5s
      start_period: 10s
      retries: 3

  # ---------------------------------------------------------------------------
  # Maintenance Bounded Context (PRODUCT_SPECIFICATION.md §2)
  # Maintenance context — keeps Radarr and Sonarr in sync with TRaSH Guides.
  # ---------------------------------------------------------------------------
  recyclarr:
    # Pinned to the major version tag `:8`. Upstream publishes NO `latest` tag
    # (it would silently apply breaking major bumps, e.g. v9). Watchtower keeps
    # this image patched within v8.x automatically.
    image: ghcr.io/recyclarr/recyclarr:8
    container_name: recyclarr
    profiles:
      - maintenance
    user: ${PUID}:${PGID}
    environment:
      - TZ=${TZ}
    volumes:
      - ./appdata/recyclarr:/config
    networks:
      - internal_api
    restart: "no"
    # No healthcheck: recyclarr is a one-shot maintenance run
    # (`docker compose run`) that exits immediately after syncing.

  watchtower:
    image: containrrr/watchtower
    container_name: watchtower
    # Zero Root Execution (AGENTS.md §3): watchtower reaches the Docker API over
    # TCP via docker-proxy (DOCKER_HOST below), so it needs no host socket
    # access and safely runs as the non-root mediasvc user.
    user: ${PUID}:${PGID}
    environment:
      - TZ=${TZ}
      - WATCHTOWER_CLEANUP=true
      - WATCHTOWER_INCLUDE_STOPPED=true
      - WATCHTOWER_SCHEDULE=0 0 4 * * *
      - DOCKER_HOST=tcp://docker-proxy:2375
      - UMASK=002
    networks:
      - socket_proxy_net
    restart: unless-stopped
    # No compose-level healthcheck: the watchtower image ships its own
    # HEALTHCHECK (visible as (healthy) in `docker ps`). Each run's outcome
    # is additionally visible in its log ("Session done" Failed=N).

  # ---------------------------------------------------------------------------
  # Maintenance Bounded Context (PRODUCT_SPECIFICATION.md §2)
  # Maintenance context — automated Library cleanup & storage reclamation.
  # Applies rules (age, watch status, ratings) to gather stale media into a
  # holding collection with a grace period, then removes it from Jellyfin,
  # the *arrs and Seerr. API keys are configured via its WebUI and stored in
  # appdata — never in .env.
  # ---------------------------------------------------------------------------
  maintainerr:
    image: ghcr.io/maintainerr/maintainerr:latest
    container_name: maintainerr
    # Zero Root Execution (AGENTS.md §3): the image accepts an explicit runtime user.
    user: ${PUID}:${PGID}
    environment:
      - TZ=${TZ}
      # Privacy: the anonymous weekly usage report is disabled by default.
      # Opt in with MAINTAINERR_TELEMETRY=on in .env.
      - TELEMETRY=${MAINTAINERR_TELEMETRY:-off}
    volumes:
      - ./appdata/maintainerr:/opt/data  # Config state (fast SSD — ARCHITECTURE.md §1)
      # Leftover-folder cleanup (optional): Maintainerr must see The Library at
      # the same path Radarr/Sonarr report it at (./data -> /data). Deleting
      # empty leftover folders requires write access, so no :ro flag. Commented
      # out by default (State vs. Compute — AGENTS.md §3).
      # - ./data:/data
    ports:
      - "6246:6246"  # WebUI. UFW-scoped to the LAN subnet by provision_host.yml.
    networks:
      - ingress_net   # Jellyfin API (Delivery bounded context)
      - internal_api  # Radarr / Sonarr / Seerr APIs (Acquisition + Media Request)
    restart: unless-stopped
    # Healthcheck ships inside the image; parameters restated here for tuning.
    healthcheck:
      test: ['CMD', '/opt/app/healthcheck.sh']
      interval: 30s
      timeout: 5s
      start_period: 40s
      retries: 3
