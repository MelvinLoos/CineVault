{# ---------------------------------------------------------------------------
   Link mode — dual-Homepage contract (docs/configuration/homepage.md).
   The configuration role renders this template twice:
     - 'lan'    -> /opt/mediastack/appdata/homepage (mediacenter.local:80):
                   every tile links to The Host directly on the local network.
     - 'remote' -> /opt/mediastack/appdata/homepage-remote
                   (dashboard.example.com via The Ingress): tiles link to the
                   Cloudflare Tunnel hostnames where one exists; LAN-only
                   services render WITHOUT an href so the remote dashboard
                   never links to an unreachable address (the tile stays
                   status-only, live widgets keep working).
   The ingress_href map is the SSOT for public hostnames — add an entry when
   a new Access-protected Public Hostname is created in the Cloudflare Zero
   Trust dashboard. Jellyfin's remote hostname is the apex domain itself.
--------------------------------------------------------------------------- #}
{% set link_mode = homepage_link_mode | default('lan') %}
{% set ingress_href = {
    'jellyfin': 'https://example.com',
    'seerr': 'https://request.example.com',
    'wizarr': 'https://join.example.com',
    'uptime-kuma': 'https://status.example.com',
} %}
{# Emit the tile href for the active link mode: a single `        href: "..."`
   line (prefixed with an explicit newline escape so it can follow the icon
   line inline) or nothing at all (remote mode, service without a public
   hostname). The explicit newline is required because ansible.builtin.template
   renders with trim_blocks=True, which would otherwise strip the newline
   after the if tags and jam the href onto the icon line. #}
{% macro tile_href(service_key, port) -%}
{%- if link_mode == 'remote' -%}
{%- if ingress_href.get(service_key) %}{{ '\n' }}        href: "{{ ingress_href.get(service_key) }}"
{%- endif -%}
{%- else %}{{ '\n' }}        href: "http://{{ web_hostname | default('mediacenter.local') }}:{{ port }}"
{%- endif -%}
{%- endmacro %}

- The Theater:
    - Jellyfin:
        icon: jellyfin{{ tile_href('jellyfin', 8096) }}
        description: Watch Movies & TV
        server: local-docker
        container: jellyfin
        widget:
            type: jellyfin
            url: http://jellyfin:8096
            key: "{{ '{{HOMEPAGE_VAR_JELLYFIN_KEY}}' }}"
            # Jellyfin >= 12 removed the legacy /emby and /mediabrowser API
            # route prefixes. Widget API version 2 calls the native endpoints
            # (Items/Counts, Sessions) with an Authorization header instead of
            # the emby/*?api_key= style of version 1 (gethomepage#7113).
            # Without this the widget surfaces "API Error: Failed to execute
            # 'json' on 'Response': Unexpected end of JSON input".
            version: 2
            enableNowPlaying: true  # Active sessions / streams
            enableUser: true
    - Seerr:
        icon: seerr{{ tile_href('seerr', 5055) }}
        description: Request New Media
        server: local-docker
        container: seerr
        widget:
            # Jellyseerr/Overseerr merged into Seerr; Homepage aliases their
            # widget types to 'seerr'. The default fields (pending/approved/
            # completed) render the open-requests widget.
            type: seerr
            url: http://seerr:5055
            key: "{{ '{{HOMEPAGE_VAR_SEERR_KEY}}' }}"
    - Wizarr:
        icon: wizarr{{ tile_href('wizarr', 5690) }}
        description: User Invitations
        server: local-docker
        container: wizarr

