- The Theater:
    - Jellyfin:
        icon: jellyfin
        href: "http://{{ web_hostname | default('mediacenter.local') }}:8096"
        description: Watch Movies & TV
        server: local-docker
        container: jellyfin
        widget:
            type: jellyfin
            url: http://jellyfin:8096
            key: "{{ '{{HOMEPAGE_VAR_JELLYFIN_KEY}}' }}"
            enableNowPlaying: true  # Active sessions / streams
            enableUser: true
    - Seerr:
        icon: seerr
        href: "http://{{ web_hostname | default('mediacenter.local') }}:5055"
        description: Request New Media
        server: local-docker
        container: seerr
        widget:
            # Jellyseerr/Overseerr merged into Seerr; Homepage aliases their
            # widget types to 'seerr'. The default fields (pending/approved/
            # completed) render the open-requests widget.
            type: seerr
            url: http://seerr:5055
            key: "{{ '{{HOMEPAGE_VAR_SEERR_KEY}}' }}"
    - Wizarr:
        icon: wizarr
        href: "http://{{ web_hostname | default('mediacenter.local') }}:5690"
        description: User Invitations
        server: local-docker
        container: wizarr

