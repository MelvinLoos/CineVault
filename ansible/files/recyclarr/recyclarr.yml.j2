# yaml-language-server: $schema=https://schemas.recyclarr.dev/v8/config-schema.json
# Recyclarr configuration (v8 schema) — rendered by the configuration role.
#
# Mirrors the official config templates as of Recyclarr 8.x:
#   - Sonarr : sonarr/templates/web-1080p.yml     (TRaSH Guides: WEB-1080p)
#   - Radarr : radarr/templates/hd-bluray-web.yml (TRaSH Guides: HD Bluray + WEB)
# Reference: https://recyclarr.dev/reference/configuration/
#
# IMPORTANT — Recyclarr does NOT manage download clients. The Sonarr ⇄ SABnzbd
# Category Tag contract belongs to the Acquisition ⇄ Processing boundary and is
# seeded via ansible/files/servarr/config.xml.j2 using the SSOT variable
# `sonarr_sabnzbd_category`. A `download_clients` key here is rejected by the
# strict v8 config parser (additionalProperties: false) and breaks every sync.
#
# Dutch prioritisation ("[Streaming Services] Dutch"):
#   - Sonarr: NLZ + VDL   (group trash_id f60f4401ce880aad62e9d21c8bb6b91a)
#   - Radarr: Pathé + VDL (group trash_id 088a792e0561c927fb396664b0db5c8f)
#   Both groups contain only required CFs, so enabling the group is the whole
#   sync; scores come from the TRaSH Guide.
#
# Dutch language preference ("Language: Prefer Dutch", +10):
#   TRaSH publishes this CF as "guide-only" (placeholder trash_id, manual
#   import in their workflow) — it is NOT part of the syncable collection.
#   It is therefore shipped locally via ansible/files/recyclarr/custom-formats/
#   and exposed through the `custom-formats` resource providers declared in
#   settings.yml.j2. The trash_ids used below are stable, repo-owned IDs.

sonarr:
  sonarr:
    base_url: http://sonarr:8989
    api_key: {{ secrets_sonarr_key }}

    quality_definition:
      type: series

    quality_profiles:
      - trash_id: 72dae194fc92bf828f32cde7744e51a1  # WEB-1080p
        reset_unmatched_scores:
          enabled: true

    custom_formats:
      # "Language: Prefer Dutch" — +10 when Dutch or Flemish audio is
      # present. Shipped via the custom-formats resource provider declared in
      # settings.yml.j2 (TRaSH guide-only CF, not in the official collection).
      - trash_ids:
          - f8318a20e9e8a8680aeb59bd5bf70dd0  # Language: Prefer Dutch
        score: 10
        assign_scores_to:
          - trash_id: 72dae194fc92bf828f32cde7744e51a1  # WEB-1080p

    custom_format_groups:
      ################################################################################
      ## Uncommented groups are synced by default. They are listed here so you can
      ## adjust which CFs they include. Commented groups are NOT synced; uncomment one
      ## to enable it.
      ##
      ## Within a group, uncomment a line under `select:` to turn an optional CF on,
      ## or under `exclude:` to turn a default CF off. Required CFs are always
      ## included and are not listed.
      ##
      ## To uncomment, remove `# ` (hash + space) so that indentation stays aligned.
      ## Most editors do this automatically with toggle-comment (Ctrl+/).
      ##
      ## https://recyclarr.dev/guide/cf-groups/
      ################################################################################
      add:
        - trash_id: 158188097a58d7687dee647e04af0da3  # [Optional] Golden Rule HD
          # Mutually exclusive: enable only one of the following.
          exclude:
            # - 47435ece6b99a0b477caf360e79ba0bb  # x265 (HD)
          select:
            # - 9b64dff695c2115facf1b6ea59c9bd07  # x265 (no HDR/DV)
        - trash_id: 74aff4168620ed49dcc67e92b2c2a5b4  # [Optional] Language Profiles
          exclude:
            # - ae575f95ab639ba5d15f663bf019e3e8  # Language: Not Original
          select:
            # - 8a9fcdbb445f2add0505926df3bb7b8a  # German
            # - ed51973a811f51985f14e2f6f290e47a  # German DL
            # - c5dd0fd675f85487ad5bdf97159180bd  # German DL (undefined)
